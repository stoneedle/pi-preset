#!/usr/bin/env node
// Deterministic native RPC fixture. It owns both its JSONL and runtime heartbeat.
import fs from 'node:fs';
import path from 'node:path';
import readline from 'node:readline';

const sessionPath = process.argv[process.argv.indexOf('--session') + 1];
if (!sessionPath || !fs.existsSync(sessionPath)) process.exit(1);
let model = { id: 'test-model', name: 'Test model', provider: 'test' };
let thinkingLevel = 'medium';
let state = 'idle';
let sequence = 0;
let timer;
let heartbeatRetry;
const followUps = [];
const statusDirectory = path.join(process.env.PI_CODING_AGENT_DIR, 'session-status');
fs.mkdirSync(statusDirectory, { recursive: true });
const statusFile = path.join(statusDirectory, `${path.basename(sessionPath)}.${process.pid}.json`);
const send = (data) => process.stdout.write(JSON.stringify(data) + '\n');
const respond = (id, command, data = {}) => send({ type: 'response', id, command, success: true, data });
function heartbeat(attempt = 0) {
  const temporary = statusFile + '.tmp';
  try {
    fs.writeFileSync(temporary, JSON.stringify({ id: path.basename(sessionPath), state, updatedAt: new Date().toISOString() }));
    fs.renameSync(temporary, statusFile);
  } catch (error) {
    if (!['EPERM', 'EACCES', 'EBUSY'].includes(error.code)) throw error;
    if (attempt < 3 && !heartbeatRetry) {
      heartbeatRetry = setTimeout(() => { heartbeatRetry = undefined; heartbeat(attempt + 1); }, 25 * (attempt + 1));
    }
  }
}
heartbeat();
const heartbeatTimer = setInterval(heartbeat, 3000);
function append(role, text, images = []) {
  const entries = fs.readFileSync(sessionPath, 'utf8').trim().split('\n').map((line) => JSON.parse(line));
  const parent = entries.filter((entry) => entry.type !== 'session').at(-1)?.id || null;
  const entry = { type: 'message', id: `stub-${process.pid}-${sequence++}`, parentId: parent, timestamp: new Date().toISOString(), message: { role, content: [{ type: 'text', text }, ...images], ...(role === 'assistant' ? { stopReason: 'stop', usage: { input: 40, output: 20, cacheRead: 60, cacheWrite: 0, totalTokens: 120, cost: { total: 0 } } } : {}) } };
  fs.appendFileSync(sessionPath, JSON.stringify(entry) + '\n');
}
function run(message, images = []) {
  const delay = /\[\[slow:(\d+)\]\]/.exec(message);
  const text = message.replace(/\s*\[\[slow:\d+\]\]\s*/, '').trim();
  state = 'running'; heartbeat(); send({ type: 'agent_start' }); append('user', text, images);
  timer = setTimeout(() => {
    append('assistant', `Stub reply: ${text}`);
    send({ type: 'agent_end' });
    if (followUps.length) { const next = followUps.shift(); run(next.message, next.images); }
    else { state = 'idle'; heartbeat(); send({ type: 'agent_settled' }); }
  }, delay ? Number(delay[1]) : 40);
}
const input = readline.createInterface({ input: process.stdin });
input.on('line', (line) => {
  let command;
  try { command = JSON.parse(line); } catch { return; }
  switch (command.type) {
    case 'get_state': respond(command.id, command.type, { model, thinkingLevel, isStreaming: state === 'running' }); break;
    case 'get_commands': respond(command.id, command.type, { commands: [{ name: 'skill:memory', description: 'Project memory', source: 'skill' }, { name: 'reload', source: 'extension' }] }); break;
    case 'set_model': model = { id: command.modelId, name: command.modelId, provider: command.provider }; respond(command.id, command.type, model); break;
    case 'set_thinking_level': thinkingLevel = command.level; respond(command.id, command.type, { thinkingLevel }); break;
    case 'abort': clearTimeout(timer); followUps.length = 0; state = 'idle'; heartbeat(); respond(command.id, command.type); send({ type: 'agent_settled' }); break;
    case 'prompt':
      respond(command.id, command.type);
      if (state === 'running' && command.streamingBehavior === 'followUp') followUps.push(command);
      else if (state === 'running') { append('user', command.message, command.images); append('assistant', `Stub reply: ${command.message}`); }
      else run(command.message, command.images);
      break;
    default: send({ type: 'response', id: command.id, success: false, error: 'unsupported command' });
  }
});
input.on('close', () => {
  clearInterval(heartbeatTimer); clearTimeout(timer); clearTimeout(heartbeatRetry);
  try { fs.unlinkSync(statusFile); } catch {}
  process.exit(0);
});
