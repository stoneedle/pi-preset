#!/usr/bin/env node
// Deterministic native RPC fixture. One process owns both its JSONL and loopback snapshot stream.
import fs from 'node:fs';
import readline from 'node:readline';
import { openFixtureOwner } from '../runtime-owner.mjs';

const sessionPath = process.argv[process.argv.indexOf('--session') + 1];
if (!sessionPath || !fs.existsSync(sessionPath)) process.exit(1);
let model = { id: 'test-model', name: 'Test model', provider: 'test' };
let thinkingLevel = 'medium';
let speed = 'off';
let state = 'idle';
let sequence = 0;
let timer;
const followUps = [];
const commands = [{ name: 'skill:example', description: 'Example skill', source: 'skill' }, { name: 'reload', source: 'extension' }];
const send = (data) => process.stdout.write(JSON.stringify(data) + '\n');
const respond = (id, command, data = {}) => send({ type: 'response', id, command, success: true, data });
function append(role, text, images = []) {
  const entries = fs.readFileSync(sessionPath, 'utf8').trim().split('\n').map((line) => JSON.parse(line));
  const parent = entries.filter((entry) => entry.type !== 'session').at(-1)?.id || null;
  const entry = { type: 'message', id: `stub-${process.pid}-${sequence++}`, parentId: parent, timestamp: new Date().toISOString(), message: { role, content: [{ type: 'text', text }, ...images], ...(role === 'assistant' ? { stopReason: 'stop', usage: { input: 40, output: 20, cacheRead: 60, cacheWrite: 0, totalTokens: 120, cost: { total: 0 } } } : {}) } };
  fs.appendFileSync(sessionPath, JSON.stringify(entry) + '\n');
}
function run(message, images = []) {
  const delay = /\[\[slow:(\d+)\]\]/.exec(message);
  const text = message.replace(/\s*\[\[slow:\d+\]\]\s*/, '').trim();
  state = 'running'; send({ type: 'agent_start' }); append('user', message, images); owner.publish();
  timer = setTimeout(() => {
    append('assistant', `Stub reply: ${text}`);
    send({ type: 'agent_end' });
    if (followUps.length) { const next = followUps.shift(); run(next.message, next.images); }
    else { state = 'idle'; owner.publish(); send({ type: 'agent_settled' }); }
  }, delay ? Number(delay[1]) : 40);
}
function prompt(message, images, delivery) {
  if (state === 'running' && delivery === 'followUp') followUps.push({ message, images });
  else if (state === 'running') { append('user', message, images); append('assistant', `Stub reply: ${message}`); owner.publish(); }
  else run(message, images);
}
function abort() { clearTimeout(timer); followUps.length = 0; state = 'idle'; owner.publish(); send({ type: 'agent_settled', aborted: true }); }
const owner = await openFixtureOwner({ agentDir: process.env.PI_CODING_AGENT_DIR, sessionPath,
  getState: () => ({ state, thinking: thinkingLevel, model: model.id, provider: model.provider, fast:{mode:speed,availableModes:['off','fast','ultrafast'],serviceTier:speed === 'off' ? null : speed === 'fast' ? 'priority' : 'ultrafast'} }),
  control: (input) => {
    switch (input.action) {
      case 'send': prompt(input.chat.message, input.chat.images || [], input.chat.delivery); break;
      case 'abort': abort(); break;
      case 'retire': if (state !== 'idle') throw new Error('not idle'); return { status: 'retiring' };
      case 'thinking': thinkingLevel = input.level; break;
      case 'speed': speed = input.mode; break;
      case 'model': model = { id: input.modelId, name: input.modelId, provider: input.provider }; break;
      case 'commands': return { commands };
      case 'models': return { models: [model, { id: 'other-model', name: 'Other model', provider: 'test' }] };
      default: throw new Error('unsupported control');
    }
    return { status: 'accepted' };
  },
});
const input = readline.createInterface({ input: process.stdin });
input.on('line', (line) => {
  let command;
  try { command = JSON.parse(line); } catch { return; }
  switch (command.type) {
    case 'get_state': respond(command.id, command.type, { model, thinkingLevel, isStreaming: state === 'running' }); break;
    case 'get_commands': respond(command.id, command.type, { commands }); break;
    case 'set_model': model = { id: command.modelId, name: command.modelId, provider: command.provider }; owner.publish(); respond(command.id, command.type, model); break;
    case 'set_thinking_level': thinkingLevel = command.level; owner.publish(); respond(command.id, command.type, { thinkingLevel }); break;
    case 'abort': abort(); respond(command.id, command.type); break;
    case 'prompt': respond(command.id, command.type); prompt(command.message, command.images, command.streamingBehavior); break;
    case 'follow_up': respond(command.id, command.type); prompt(command.message, command.images, 'followUp'); break;
    default: send({ type: 'response', id: command.id, success: false, error: 'unsupported command' });
  }
});
input.on('close', async () => { clearTimeout(timer); await owner.close(); process.exit(0); });
