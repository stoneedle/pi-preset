{
  "name": "@stoneedle/pi-web",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.19.0" },
  "description": "个人自用的 Pi 手机远程界面",
  "version": "0.0.1-beta.38-stoneedle.1",
  "pi": {
    "extensions": ["./.pi/extensions/index.ts"]
  },
  "scripts": {
    "postinstall": "node scripts/run-lifecycle.mjs install",
    "preuninstall": "node scripts/run-lifecycle.mjs uninstall",
    "test:extensions": "vitest run --config tests/extensions/vitest.config.ts && node --test tests/native/*.test.ts"
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.3.0",
    "@earendil-works/pi-tui": "*"
  },
  "license": "MIT",
  "devDependencies": {
    "vitest": "^4.1.7"
  }
}
